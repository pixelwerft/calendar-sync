{# FullCalendar, fed by the JSON feed of a calendar. Switch on «Public feed» for the calendar first.
   FullCalendar asks the feed for the period it shows and passes it as ?start=…&end=… #}
{% set feed = craft.calendarSync.feedUrl('team', 'json') %}

{% if feed %}
  <div id="calendar"></div>

  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      new FullCalendar.Calendar(document.getElementById('calendar'), {
        initialView: 'dayGridMonth',
        firstDay: 1,
        locale: '{{ craft.app.language|slice(0, 2) }}',
        headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,listMonth' },
        events: {{ feed|json_encode|raw }},
        eventDidMount: function (info) {
          var props = info.event.extendedProps;
          if (props.location) {
            info.el.title = props.location;
          }
        },
      }).render();
    });
  </script>
{% else %}
  <p>The feed of this calendar is switched off.</p>
{% endif %}
