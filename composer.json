{
  "name": "pixelwerft/calendar-sync",
  "description": "Connect Google Calendar, Microsoft 365 / Outlook, CalDAV and public iCal calendars to Craft: sync events in either direction, map them to the fields of your own entries and present them with Twig, GraphQL, feeds and dashboard widgets.",
  "type": "craft-plugin",
  "license": "craft",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "calendar",
    "sync",
    "google-calendar",
    "microsoft-365",
    "outlook",
    "caldav",
    "ical",
    "ics",
    "events"
  ],
  "support": {
    "email": "ahoi@pixelwerft.ch",
    "issues": "https://github.com/pixelwerft/calendar-sync/issues",
    "source": "https://github.com/pixelwerft/calendar-sync",
    "docs": "https://github.com/pixelwerft/calendar-sync/blob/main/README.md"
  },
  "authors": [
    {
      "name": "pixelwerft",
      "homepage": "https://pixelwerft.ch"
    }
  ],
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.3.0",
    "sabre/vobject": "^4.5"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "pixelwerft\\calendarsync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "pixelwerft\\calendarsync\\tests\\": "tests/"
    }
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit"
  },
  "extra": {
    "handle": "calendar-sync",
    "name": "Calendar Sync",
    "developer": "pixelwerft",
    "developerUrl": "https://pixelwerft.ch",
    "documentationUrl": "https://github.com/pixelwerft/calendar-sync/blob/main/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/pixelwerft/calendar-sync/main/CHANGELOG.md",
    "class": "pixelwerft\\calendarsync\\CalendarSync"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
